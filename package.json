{
  "name": "samo-chat",
  "displayName": "SaMo Chat",
  "description": "SaMo is your AI coding assistant in VS Code: chat, build and debug projects, edit files, run tests, and review changes.",
  "version": "0.4.14",
  "publisher": "devsanjib",
  "author": {
    "name": "Sanjib Roy"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "samo",
    "chat",
    "ai",
    "assistant",
    "coding",
    "programming",
    "chatgpt",
    "copilot"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#171717",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/snbroy/Samo-AI.git",
    "directory": "vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/snbroy/Samo-AI/issues"
  },
  "homepage": "https://github.com/snbroy/Samo-AI/tree/main/vscode-extension#readme",
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "samo.openChat",
        "title": "SaMo: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "samo.clearChat",
        "title": "SaMo: Clear Chat History"
      },
      {
        "command": "samo.newChat",
        "title": "SaMo: New Conversation"
      },
      {
        "command": "samo.switchConversation",
        "title": "SaMo: Switch Conversation"
      },
      {
        "command": "samo.setAccessToken",
        "title": "SaMo: Set Access Token"
      },
      {
        "command": "samo.openAccountPortal",
        "title": "SaMo: Open Account Portal"
      },
      {
        "command": "samo.mcp.listTools",
        "title": "SaMo: List MCP Tools"
      },
      {
        "command": "samo.mcp.callTool",
        "title": "SaMo: Run MCP Tool"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "samo-chat-container",
          "title": "SaMo",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "samo-chat-container": [
        {
          "type": "webview",
          "id": "samo.chatView",
          "name": "Chat",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "samo.clearChat",
          "when": "view == samo.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "SaMo Chat",
      "properties": {
        "samo.apiUrl": {
          "type": "string",
          "default": "https://vs.samotech.co.in",
          "description": "Base URL of the SaMo VS Portal API. Defaults to https://vs.samotech.co.in."
        },
        "samo.email": {
          "type": "string",
          "default": "",
          "description": "Email address associated with your SaMo VS Portal account."
        },
        "samo.requestTimeoutSeconds": {
          "type": "integer",
          "default": 120,
          "minimum": 15,
          "maximum": 300,
          "description": "Maximum time without response data before a SaMo request is stopped."
        },
        "samo.autocomplete.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show SaMo inline code suggestions (ghost text, accept with Tab) while you type."
        },
        "samo.inlineEdit.enlargeCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Increase the editor CodeLens font size so SaMo's Keep / Undo buttons are easy to read."
        },
        "samo.runTests": {
          "type": "boolean",
          "default": true,
          "description": "After SaMo applies code changes, run detected tests, typecheck, lint, and build checks as regression checks. Only runs in trusted workspaces."
        },
        "samo.maxFixIterations": {
          "type": "integer",
          "default": 2,
          "minimum": 0,
          "maximum": 5,
          "description": "How many times SaMo may automatically fix its own changes when regression tests fail."
        },
        "samo.maxUnderstandFiles": {
          "type": "integer",
          "default": 80,
          "minimum": 10,
          "maximum": 300,
          "description": "Maximum number of files SaMo reads line by line when asked to understand a project or folder."
        },
        "samo.mcp.servers": {
          "type": "array",
          "scope": "application",
          "default": [],
          "description": "User-level MCP stdio server configurations. Servers start only after confirmation; every tool call requires separate approval. Environment values are stored in VS Code user settings, so prefer inherited shell environment variables for secrets.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "command"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Unique server label."
              },
              "command": {
                "type": "string",
                "description": "Executable used to launch the MCP server."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments."
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Environment overrides. Avoid storing credentials here; use inherited environment variables where possible."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "test": "tsc --outDir out --sourceMap false && node --test test/*.test.js",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.20.0",
    "markdown-it": "^15.0.2",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "ajv": "^8.20.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  }
}
